# ============================================================================
# Apache Airflow 3.4.0 Local Deployment Environment Example (NO SECRETS)
# Copy to `.env` before running `docker compose up` and replace placeholders.
# ============================================================================

# Linux host UID for Airflow container file ownership (run `id -u` on Linux/WSL2)
AIRFLOW_UID=50000

# Airflow Metadata PostgreSQL (local dev only — replace with strong values)
AIRFLOW_PG_USER=airflow
AIRFLOW_PG_PASSWORD=replace_with_local_postgres_password
AIRFLOW_PG_DB=airflow

# Generate Fernet key: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=replace_with_generated_fernet_key
AIRFLOW_JWT_SECRET=replace_with_random_jwt_secret

# Absolute or relative path on host to the existing global_restaurant_explorer_etl checkout
ETL_PROJECT_HOST_PATH=../global_restaurant_explorer_etl

# Non-secret ETL runtime settings
ETL_SOURCE_CSV=data/zomato_cleaned.csv
AIRFLOW_ETL_SCHEDULE=
DB_DIALECT=mysql
STORAGE_BACKEND=local
BRONZE_LOCAL_PATH=data/bronze
QUARANTINE_PATH=data/quarantine
REPORTS_PATH=data/reports
LOGS_PATH=logs

# Optional: configure target MySQL via Airflow Connection `mysql_zomato_explorer`
# instead of environment variables (see README_AIRFLOW_SETUP.md).
# Optional Azure Blob Storage (leave blank unless STORAGE_BACKEND=azure):
AZURE_STORAGE_CONTAINER=bronze-zomato
