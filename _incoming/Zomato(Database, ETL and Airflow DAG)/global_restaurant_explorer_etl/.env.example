# Database Configuration (MySQL 8.0 default for production)
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=zomato_restaurant_explorer
DB_USER=your_username
DB_PASSWORD=your_password
DB_POOL_SIZE=5
DB_CONNECT_TIMEOUT=15

# Optional SQLite path (only used when DB_DIALECT=sqlite for isolated local testing)
SQLITE_DB_PATH=data/zomato_test.sqlite

# Bronze Storage Configuration (local | azure)
STORAGE_BACKEND=local
BRONZE_LOCAL_PATH=data/bronze
QUARANTINE_PATH=data/quarantine
REPORTS_PATH=data/reports
LOGS_PATH=logs

# Optional Azure Blob Storage Configuration (used when STORAGE_BACKEND=azure)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=bronze-zomato
